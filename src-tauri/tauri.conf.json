{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eden ModHub",
  "version": "0.1.0",
  "identifier": "dev.edenmodhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Eden ModHub",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "zoomHotkeysEnabled": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
